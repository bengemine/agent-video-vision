{
  "name": "agent-video-vision",
  "version": "0.1.0",
  "description": "Local-only video perception MCP server for AI coding agents (Claude Code, Codex)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agent-video-vision": "dist/index.js"
  },
